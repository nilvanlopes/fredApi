DATABASE_URL=postgresql+asyncpg://fred:fred@postgres:5432/fred
MONTHLY_SUBSCRIPTION_PRICE_CENTS=1250
CONVERSATION_IMPORT_MAX_BYTES=2000000
CONVERSATION_AI_BASE_URL=http://host.docker.internal:11434/v1
CONVERSATION_AI_API_KEY=ollama
CONVERSATION_AI_MODEL=qwen2.5:7b
CONVERSATION_AI_CONFIDENCE_THRESHOLD=0.90
CONVERSATION_AI_BATCH_MESSAGES=20
CONVERSATION_AI_BATCH_CHARS=12000
CONVERSATION_AI_ATTEMPTS=2
CONVERSATION_AI_TIMEOUT_SECONDS=240
OLLAMA_MANAGE_SERVICE=true
OLLAMA_SHUTDOWN_WHEN_DONE=true
OLLAMA_PULL_MODEL_WHEN_MISSING=true
OLLAMA_ENABLE_GPU=true
OLLAMA_STARTUP_TIMEOUT_SECONDS=180
OLLAMA_POLL_INTERVAL_SECONDS=2
OLLAMA_COMPOSE_FILE=
OLLAMA_DOCKER_SOCKET=/var/run/docker.sock
OLLAMA_CONTAINER_NAME=fred-ollama
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_VOLUME=ollama_ollama-data

# Management portal (the compose file sets production URLs)
FRED_PUBLIC_URL=https://fred.nilvanlopes.com
AUTHENTIK_BASE_URL=https://login-fred.nilvanlopes.com
AUTHENTIK_INTERNAL_URL=http://server:9000
AUTHENTIK_AUTH_URL=http://authentik-outpost-fred_proxy:9000/outpost.goauthentik.io/auth/traefik

# WhatsApp payment-list updates via n8n. Set both values to enable delivery.
FRED_PAYMENT_WEBHOOK_URL=
FRED_PAYMENT_WEBHOOK_TOKEN=
FRED_PAYMENT_WHATSAPP_CHAT_ID=

# Private profile images: server only, never VITE_* variables.
FRED_PROFILE_S3_ENDPOINT=http://floci:4566
FRED_PROFILE_S3_REGION=us-east-1
FRED_PROFILE_S3_BUCKET=fred-profile-images
FRED_PROFILE_S3_ACCESS_KEY_ID=
FRED_PROFILE_S3_SECRET_ACCESS_KEY=
