DATABASE_URL=postgresql+asyncpg://fred:fred@postgres:5432/fred
CONVERSATION_IMPORT_MAX_BYTES=2000000
CONVERSATION_AI_BASE_URL=http://host.docker.internal:11434/v1
CONVERSATION_AI_API_KEY=ollama
CONVERSATION_AI_MODEL=qwen2.5:7b
CONVERSATION_AI_CONFIDENCE_THRESHOLD=0.90
CONVERSATION_AI_BATCH_MESSAGES=20
CONVERSATION_AI_BATCH_CHARS=12000
CONVERSATION_AI_ATTEMPTS=2
CONVERSATION_AI_TIMEOUT_SECONDS=240
OLLAMA_MANAGE_SERVICE=true
OLLAMA_SHUTDOWN_WHEN_DONE=true
OLLAMA_PULL_MODEL_WHEN_MISSING=true
OLLAMA_ENABLE_GPU=true
OLLAMA_STARTUP_TIMEOUT_SECONDS=180
OLLAMA_POLL_INTERVAL_SECONDS=2
OLLAMA_COMPOSE_FILE=
OLLAMA_DOCKER_SOCKET=/var/run/docker.sock
OLLAMA_CONTAINER_NAME=fred-ollama
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_VOLUME=ollama_ollama-data
